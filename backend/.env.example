# Copy to backend/.env for local development. All values are read by backend/src/config/index.js.
# .env is gitignored; never commit real secrets.

# --- Server ---
# HTTP port the API listens on (default: 3001)
PORT=3001
# development | test | production (default: development)
NODE_ENV=development
# Allowed CORS origin for the frontend (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# --- Logging ---
# error | warn | info | http | verbose | debug | silly (default: info)
LOG_LEVEL=info
# morgan format; default: 'combined' when NODE_ENV=production, otherwise 'dev'
LOG_FORMAT=dev

# --- JWT ---
# Signing secret. REQUIRED (min 32 chars) when NODE_ENV=production; startup fails without it.
JWT_SECRET=
# Token lifetime (default: 24h)
JWT_EXPIRES_IN=24h

# --- Database ---
# Optional external database connection string (no default)
DATABASE_URL=
# SQLite file path, or ':memory:' for an in-memory DB (default: :memory:)
DATABASE_PATH=:memory:

# --- Rate limiting ---
# Window size in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window (default: 100)
RATE_LIMIT_MAX=100

# --- Body parsing ---
# Max JSON request body size (default: 10mb)
BODY_LIMIT=10mb

# --- Feature flags ---
# Defaults live in backend/src/config/features.json. Override any flag with FEATURE_<UPPER_SNAKE_NAME>.
# Truthy values (case-insensitive): 1, true, yes, on. Anything else is false. Unset = JSON default.
# Exposed to the frontend via GET /api/config.
# Dark mode UI toggle (default: false)
FEATURE_DARK_MODE=false
# CSV export of reports (default: true)
FEATURE_CSV_EXPORT=true
# PDF report generation (default: true)
FEATURE_PDF_REPORTS=true

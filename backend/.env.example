# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS. Comma-separated list; leave unset in production when the SPA is
# served from the same origin as the API.
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=https://timesheet.example.com

# JWT Configuration
# REQUIRED: the server refuses to start without this. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# bcrypt cost factor for password hashing. Leave at the default in production.
BCRYPT_ROUNDS=12

# Send HTTP Strict-Transport-Security. Only enable once TLS is terminated in front of the app.
ENABLE_HSTS=false

# Database Configuration (using SQLite in-memory as specified)
# No database configuration needed for in-memory SQLite
# For production persistence, consider using file-based SQLite instead
